    {
      "parameters": {
        "jsCode": "// Validates the AI output and maps it to the Join task shape.\n// Falls back to the raw mail if the AI answer is unusable, so no request gets lost.\nconst CATEGORIES = ['User Story', 'Technical task', 'Bug'];\nconst PRIORITIES = ['urgent', 'medium', 'low'];\nconst AI_NOTE = 'This ticket was AI-generated.';\nconst today = DateTime.now().setZone('Europe/Berlin');\n\nfunction text(value, max) {\n  return String(value ?? '').trim().slice(0, max);\n}\n\nfunction parseAi(response) {\n  try {\n    return JSON.parse(response.content.find((block) => block.type === 'text').text);\n  } catch (err) {\n    console.log('Could not parse AI response', err.message);\n    return {};\n  }\n}\n\nfunction dueDate(value) {\n  const d = DateTime.fromISO(String(value ?? ''), { zone: 'Europe/Berlin' });\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(value) && d.isValid && d >= today.startOf('day')) return d.toISODate();\n  return today.plus({ days: 7 }).toISODate();\n}\n\nreturn $input.all().map((item, i) => {\n  const mail = $('Check Limit').itemMatching(i).json;\n  const ai = parseAi(item.json);\n  const subtasks = Array.isArray(ai.subtasks) ? ai.subtasks : [];\n  const description = text(ai.description, 600) || text(mail.body, 600);\n\n  return {\n    json: {\n      column: 'triage',\n      title: text(ai.title, 80) || text(mail.subject, 80) || 'Request via email',\n      description: description ? `${description}\\n\\n${AI_NOTE}` : AI_NOTE,\n      dueDate: dueDate(ai.dueDate),\n      category: CATEGORIES.includes(ai.category) ? ai.category : 'User Story',\n      priority: PRIORITIES.includes(ai.priority) ? ai.priority : 'medium',\n      assignedContacts: [],\n      subtasks: subtasks.slice(0, 5).map((s) => text(s, 80)).filter(Boolean).map((name) => ({ name, checked: false })),\n      createdAt: new Date().toISOString(),\n      source: 'email',\n      requester: text(mail.from, 200),\n      requesterName: text(mail.fromName, 200),\n      dateKey: mail.dateKey,\n    },\n    pairedItem: { item: i },\n  };\n});"
      },
