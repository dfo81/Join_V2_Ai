    {
      "parameters": {
        "jsCode": "// Flags every mail as within or over today's quota, in arrival order.\nconst DAILY_LIMIT = 10;\nconst used = Number($input.first().json.data) || 0;\nconst mails = $('Prepare Email').all();\n\nreturn mails.map((mail, i) => ({\n  json: { ...mail.json, withinLimit: used + i < DAILY_LIMIT },\n  pairedItem: { item: 0 },\n}));"
      },
