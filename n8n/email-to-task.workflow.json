      "id": "65bfb407-960e-487a-a64e-cb8deb5d7c54",
      "name": "Claude: Extract Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -512,
        784
      ],
      "retryOnFail": true,
