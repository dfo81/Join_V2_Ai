    {
      "parameters": {
        "jsCode": "// Finds tasks whose column changed since the creator was last notified.\n// Tasks seen for the first time are only marked, so nobody gets a mail for the initial column.\nconst LABELS = { triage: 'Triage', todo: 'To do', inProgress: 'In progress', awaitFeedback: 'Await feedback', done: 'Done' };\nconst tasks = $input.first().json || {};\n\n/** Returns name and email of the task creator (email requester or logged-in member). */\nfunction creatorOf(task) {\n  if (task.source === 'email') return { name: task.requesterName || '', email: task.requester || '' };\n  const c = task.createdBy || {};\n  return { name: c.name || '', email: c.email || '' };\n}\n\nreturn Object.entries(tasks)\n  .filter(([, task]) => task && typeof task === 'object' && task.column && task.column !== task.lastNotifiedColumn)\n  .map(([taskId, task]) => {\n    const creator = creatorOf(task);\n    const firstSeen = !task.lastNotifiedColumn;\n    return {\n      json: {\n        taskId,\n        title: String(task.title || 'Untitled task'),\n        column: task.column,\n        fromLabel: LABELS[task.lastNotifiedColumn] || task.lastNotifiedColumn || '',\n        toLabel: LABELS[task.column] || task.column,\n        name: creator.name,\n        email: firstSeen ? '' : creator.email,\n      },\n    };\n  });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        0
      ],
      "id": "03633218-759f-439d-aac6-a7d00728a2f0",
      "name": "Find Column Changes"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "2425550c-1ad8-4193-89d0-f164f25165eb",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1152,
        0
      ],
      "id": "03efc433-13e6-4827-ac6c-6f41c034c4d9",
